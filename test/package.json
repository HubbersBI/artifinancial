{
  "name": "artifinancial-e2e",
  "private": true,
  "version": "0.1.0",
  "description": "Playwright end-to-end suite for Artifinancial (PLAN section 12)",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "docker:test": "docker compose -f docker-compose.test.yml up --build --abort-on-container-exit --exit-code-from playwright",
    "docker:down": "docker compose -f docker-compose.test.yml down -v"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^26.3.0",
    "typescript": "^7.0.2"
  }
}
