# Required: Groq API key for the LLM chat assistant.
# Free tier, no credit card: https://console.groq.com -> API Keys
GROQ_API_KEY=your-groq-api-key-here

# Optional: Massive (Polygon.io) API key for real market data.
# If empty, the built-in GBM market simulator is used (recommended for most users).
MASSIVE_API_KEY=

# Optional: "true" returns deterministic mock LLM responses.
# Use this for development and E2E tests - no API key needed, no quota consumed.
LLM_MOCK=false
